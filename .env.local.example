# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Needed for the V3 scoring routes, which write to tables users
# cannot write to directly. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional
GITHUB_TOKEN=          # higher GitHub API rate limits for repository probes
OPENAI_API_KEY=        # LLM skill analysis; a deterministic fallback is used without it
OPENAI_MODEL=          # defaults to gpt-4o-mini
CRON_SECRET=           # lets a scheduler call /api/scoring/v3/process-queue
